# Supabase Dashboard -> Project settings / Connect -> Project URL and publishable key
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Do NOT use a secret/service-role key here. This app uses the user's session + RLS.

# OPTIONAL: live chatbot. Both values are server-only. Leave blank for honest
# server-side matching mode; choose a model supporting Responses + Structured Outputs.
OPENAI_API_KEY=
OPENAI_MODEL=
